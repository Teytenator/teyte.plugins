{
  "fontFamily": "JetBrainsMono Nerd Font",
  "fontSize": 15,
  "color": "#ffffff",
  "bgColor": "#000000",
  "bgOpacity": 0.5,
  "accentColor": "#66ccff",
  "radius": 0,
  "padding": 16,
  "width": 720,
  "paletteYRatio": 0.28,
  "opacity": 1.0,
  "agent": "opencode",
  "agentArgs": [],
  "terminal": "foot",
  "cwd": "auto",
  "placeholder": "Search the web or @ for the agent…",
  "barLabel": "⌕ search web…",
  "historyLimit": 50,
  "xRatio": 0.5,
  "yRatio": 0.93,
  "xOffset": 0,
  "yOffset": 0,
  "namespace": "teyte.prompt",
  "barNamespace": "teyte.prompt-bar",
  "modesEnabled": true,
  "notePath": "~/inbox.md",
  "defaultMode": "search",
  "searchUrl": "https://www.google.com/search?q=%s"
}
